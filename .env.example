# =============================================================================
#  Anime Epic Moments — пример конфигурации окружения
#  Скопируйте этот файл в .env и заполните свои значения.
#  Комментарии на русском, секции сгруппированы по назначению.
# =============================================================================

# -----------------------------------------------------------------------------
#  Базовые настройки приложения
# -----------------------------------------------------------------------------
# Секретный ключ для подписи JWT и сессий. Обязательно смените на свой.
SECRET_KEY=test-secret-key-change-me

# Хост/порт HTTP-сервера и режим отладки (1 = включён, 0 = выключен)
APP_HOST=0.0.0.0
APP_PORT=5000
APP_DEBUG=0

# Публичный адрес приложения (используется в ссылках в письмах и уведомлениях)
APP_BASE_URL=http://127.0.0.1:5000
APP_PUBLIC_HOST=
APP_PUBLIC_PORT=5000
APP_PUBLIC_SCHEME=http

# Разрешённые Origin для CORS (через запятую)
APP_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://192.168.0.111:5000

# -----------------------------------------------------------------------------
#  База данных PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=anime_epic_moments_db
POSTGRES_USER=anime_epic_moments_user
POSTGRES_PASSWORD=anime_epic_moments_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Полная строка подключения (если указана — используется вместо полей выше)
DATABASE_URL=postgresql+psycopg://anime_epic_moments_user:anime_epic_moments_password@localhost:5432/anime_epic_moments_db
# Автосоздание таблиц при старте (1 = да, 0 = нет)
DATABASE_AUTO_INIT=0

# -----------------------------------------------------------------------------
#  AI-сервисы: поиск аниме по описанию и анализ вкусов
#  Используются в связке: Gemini — основной, Hugging Face — запасной.
# -----------------------------------------------------------------------------
# OpenRouter (primary). Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Модель в формате vendor/model (например stealth/ox-alpha, anthropic/claude-3.5-sonnet)
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# Hugging Face (fallback). Токен: https://huggingface.co/settings/tokens
HF_TOKEN=your-huggingface-token
# Провайдер инференса (fireworks-ai, groq, together и т.п.)
HF_PROVIDER=fireworks-ai
# Модель; для Fireworks формат "openai/gpt-oss-120b:fireworks-ai"
HF_MODEL=openai/gpt-oss-120b:fireworks-ai
HF_API_URL=https://router.huggingface.co/v1/chat/completions

# Google Gemini (primary). Ключ: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-gemini-api-key
# Модель (gemini-2.0-flash, gemini-2.5-flash и т.п.)
GOOGLE_MODEL=gemini-2.0-flash
GOOGLE_API_URL=https://generativelanguage.googleapis.com/v1beta

# -----------------------------------------------------------------------------
#  Русские названия и описания аниме (Shikimori)
# -----------------------------------------------------------------------------
# Shikimori — русскоязычная база аниме (зеркало MAL). Используется для
# обогащения карточек русскими названиями и синопсисами: данные матчатся
# по MAL-id, запросы идут пачками и кэшируются на 30 дней.
# Включён по умолчанию (1). Публичные эндпоинты работают без токена.
SHIKIMORI_ENABLED=1
SHIKIMORI_API_URL=https://shikimori.one/api
# Необязательный OAuth-токен: поднимает персональный rate-limit.
SHIKIMORI_TOKEN=
# Shikimori требует идентифицирующий User-Agent в каждом запросе.
SHIKIMORI_USER_AGENT=AnimeEpicMoments/1.0 (anime-epic-moments)

# -----------------------------------------------------------------------------
#  Видео-провайдеры: поиск серий и озвучек
#  Чем больше настроено провайдеров, тем больше озвучек найдётся.
# -----------------------------------------------------------------------------
# Kodik — главный источник всех русских озвучек (AniDUB, Комната Диди и др.)
# Рабочий публичный токен берётся из kdk_tokns/tokens.json (папка только для
# разработчиков, в git не попадает): расшифровать кандидат и подставить сюда.
# Если токен протухнет — взять следующий рабочий из того же файла.
KODIK_API_TOKEN=your-kodik-public-token
KODIK_API_URL=https://kodik-api.com

# AniLibria — собственная озвучка AniLibria (HLS, без токена)
ANILIBRIA_API_URL=https://anilibria.top/api/v1

# SameBand — SSR-источник HLS (необязательно, по умолчанию выключен)
SAMEBAND_ENABLED=0
SAMEBAND_BASE_URL=https://sameband.studio
SAMEBAND_TIMEOUT=8

# AniBoom — embed-плеер-экстрактор. У источника нет поискового индекса:
# через единый интерфейс поиска он ничего не возвращает, поэтому выключен.
# Включайте только если подключаете ручной путь от embed-URL (extract_embed).
ANIBOOM_ENABLED=0
ANIBOOM_BASE_URL=https://aniboom.one
ANIBOOM_TIMEOUT=8

# Hanime.tv — публичный JSON API v8: оригинальные HLS-потоки для 18+ тайтлов,
# которых нет в Kodik/Kinobox/AnimeGo. Без токена. Включён по умолчанию.
# Сайт за Cloudflare: запросы идут через curl_cffi с браузерным TLS-отпечатком.
# Если DNS/IP хоста блокируются на уровне сети (РКН и т.п.) — укажите прокси
# локального VPN-клиента, например HANIME_PROXY=http://127.0.0.1:3066.
# Если Cloudflare отдаёт челлендж («Just a moment...», cf-mitigated: challenge):
# 1) откройте hanime.tv в браузере ЧЕРЕЗ ТОТ ЖЕ VPN-узел;
# 2) F12 -> Application -> Cookies -> https://hanime.tv -> скопируйте cf_clearance;
# 3) вставьте значение ниже вместе с User-Agent вашего браузера
#    (в консоли F12 выполните navigator.userAgent). Куки и IP должны совпадать
#    с тем, что использует провайдер, иначе CF снова отправит челлендж.
HANIME_ENABLED=1
HANIME_BASE_URL=https://hanime.tv
HANIME_TIMEOUT=10
HANIME_PROXY=
HANIME_CF_CLEARANCE=
HANIME_USER_AGENT=

# Прокси для медиа-прокси (стриминг видео через /watch/proxy).
# Нужен, если CDN заблокирован на уровне сети (например, mushy.tv для Hanime).
# Указывайте http://-прокси локального VPN-клиента, например http://127.0.0.1:3066.
MEDIA_PROXY_PROXY=

# Kinobox — агрегатор плееров (Kodik/Alloha/Collaps/Rezka и др.) через JSON API,
# без kinobox.js и его промо-UI. Работает без токена.
# Выключен: kinobox.tv в данный момент редиректит /api/players на сторонний файл.
KINOBOX_ENABLED=0
KINOBOX_BASE_URL=https://kinobox.tv
KINOBOX_TIMEOUT=8

# AnimeGo — скрейпер каталога фандаба: редкие озвучки (Onwave, Комната Диди и др.)
# и embed-плееры AniBoom/Sibnet. Потоки извлекают экстракторы Sibnet/AniBoom.
ANIMEGO_ENABLED=0
ANIMEGO_BASE_URL=https://animego.org
ANIMEGO_TIMEOUT=10

# Sibnet — экстрактор прямых MP4 из embed-страниц видеохостинга (без токена).
SIBNET_ENABLED=0
SIBNET_BASE_URL=https://video.sibnet.ru
SIBNET_TIMEOUT=8

# HDRezka (voidboost) — парсер прямых потоков. Сайт часто меняет защиту:
# при шифровании ссылок провайдер не возвращает источников. Выключен по умолчанию.
REZKA_ENABLED=0
REZKA_BASE_URL=https://rezka.ag
REZKA_TIMEOUT=10

# YouTube — поиск серий на YouTube (необязательно)
# Ключ: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-data-api-key
YOUTUBE_API_URL=https://www.googleapis.com/youtube/v3
# Ограничение по каналам (через запятую); пусто = все каналы
YOUTUBE_ALLOWED_CHANNEL_IDS=

# JustWatch — каталог легальных площадок (необязательно)
JUSTWATCH_PARTNER_TOKEN=your-justwatch-partner-token
JUSTWATCH_API_URL=https://apis.justwatch.com/contentpartner/v2/content
JUSTWATCH_LOCALE=en_US

# -----------------------------------------------------------------------------
#  Поддержка пользователей: Telegram-бот и email-уведомления
# -----------------------------------------------------------------------------
# Telegram-бот для заявок в поддержку. Создать: @BotFather.
# Админ-чаты (через запятую): укажите chat_id, куда слать заявки.
TELEGRAM_SUPPORT_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_SUPPORT_API_URL=https://api.telegram.org
TELEGRAM_SUPPORT_ADMIN_CHAT_IDS=123456789,987654321

# SMTP для писем: подтверждение email, сброс пароля.
# Для Gmail используйте app-password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your@gmail.com
SMTP_USE_TLS=1
# Срок жизни ссылок подтверждения/сброса (в минутах)
EMAIL_VERIFICATION_EXPIRE_MINUTES=10
PASSWORD_RESET_EXPIRE_MINUTES=30

# Получатели писем поддержки (через запятую)
SUPPORT_EMAIL_TO=support@example.com
